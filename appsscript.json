{
  "timeZone": "Asia/Tbilisi",
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "dependencies": {
    "enabledAdvancedServices": [
      {
        "userSymbol": "Calendar",
        "serviceId": "calendar",
        "version": "v3"
      }
    ]
  },
  "oauthScopes": [
    "https://www.googleapis.com/auth/script.external_request",
    "https://www.googleapis.com/auth/script.scriptapp",
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.action.compose",
    "https://www.googleapis.com/auth/gmail.addons.current.message.metadata",
    "https://www.googleapis.com/auth/script.locale",
    "https://www.googleapis.com/auth/userinfo.email",
    "https://www.googleapis.com/auth/calendar.readonly",
    "https://www.googleapis.com/auth/calendar.events",
    "https://www.googleapis.com/auth/calendar.addons.execute",
    "https://www.googleapis.com/auth/workspace.linkpreview"
  ],
  "urlFetchWhitelist": [
    "https://api.carbonvoice.app/"
  ],
  "addOns": {
    "common": {
      "universalActions": [
        {
          "label": "About Carbon Voice",
          "openLink": "https://www.getcarbon.app/"
        },
        {
          "label": "Settings",
          "runFunction": "showSettingsCard"
        }
      ],
      "name": "TEST Carbon Voice",
      "logoUrl": "https://drive.google.com/uc?export=view&id=19ud-iqFGf_1LmEJa6KpMkjVPCLdbV-nf",
      "layoutProperties": {
        "primaryColor": "#f2efff",
        "secondaryColor": "#5E4CCE"
      },
      "useLocaleFromApp": true,
      "homepageTrigger": {
        "runFunction": "onHomepageLinksPreview"
      }
    },
    "calendar": {
      "homepageTrigger": {
        "runFunction": "onHomepageCalendar"
      },
      "eventOpenTrigger": {
        "runFunction": "onCalendarEventOpen"
      }
    },
    "gmail": {
      "homepageTrigger": {
        "runFunction": "onHomepage"
      },
      "contextualTriggers": [
        {
          "unconditional": {},
          "onTriggerFunction": "asyncMeetingCardContextSidebar"
        }
      ],
      "composeTrigger": {
        "selectActions": [
          {
            "text": "Carbon Voice",
            "runFunction": "showVoiceMemosCard"
          }
        ]
      },
      "openLinkUrlPrefixes": [
        "https://api.carbonvoice.app",
        "https://carbonvoice.app"
      ]
    },
    "docs": {
      "linkPreviewTriggers": [
        {
          "patterns": [
            {
              "hostPattern": "carbonvoice.app",
              "pathPrefix": "s"
            }
          ],
          "runFunction": "previewVoiceMemos",
          "labelText": "Carbon Voice Memo",
          "logoUrl": "https://pxassets.s3.us-east-2.amazonaws.com/images/google-addons/Voice+Memo+CV400.png"
        },
        {
          "patterns": [
            {
              "hostPattern": "carbonvoice.app",
              "pathPrefix": "c"
            }
          ],
          "runFunction": "previewConversations",
          "labelText": "Carbon Voice Conversation",
          "logoUrl": "https://pxassets.s3.us-east-2.amazonaws.com/images/google-addons/cv-logo-48-purple.png"
        }
      ]
    },
    "sheets": {
      "linkPreviewTriggers": [
        {
          "patterns": [
            {
              "hostPattern": "carbonvoice.app",
              "pathPrefix": "s"
            }
          ],
          "runFunction": "previewVoiceMemos",
          "labelText": "Carbon Voice Memo",
          "logoUrl": "https://pxassets.s3.us-east-2.amazonaws.com/images/google-addons/Voice+Memo+CV400.png"
        },
        {
          "patterns": [
            {
              "hostPattern": "carbonvoice.app",
              "pathPrefix": "c"
            }
          ],
          "runFunction": "previewConversations",
          "labelText": "Carbon Voice Conversation",
          "logoUrl": "https://pxassets.s3.us-east-2.amazonaws.com/images/google-addons/cv-logo-48-purple.png"
        }
      ]
    },
    "slides": {
      "linkPreviewTriggers": [
        {
          "patterns": [
            {
              "hostPattern": "carbonvoice.app",
              "pathPrefix": "s"
            }
          ],
          "runFunction": "previewVoiceMemos",
          "labelText": "Carbon Voice Memo",
          "logoUrl": "https://pxassets.s3.us-east-2.amazonaws.com/images/google-addons/Voice+Memo+CV400.png"
        },
        {
          "patterns": [
            {
              "hostPattern": "carbonvoice.app",
              "pathPrefix": "c"
            }
          ],
          "runFunction": "previewConversations",
          "labelText": "Carbon Voice Conversation",
          "logoUrl": "https://pxassets.s3.us-east-2.amazonaws.com/images/google-addons/cv-logo-48-purple.png"
        }
      ]
    }
  }
}